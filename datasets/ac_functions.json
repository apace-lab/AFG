{
    "_schema_notes": {
        "purpose": "Reference dataset of access-control (authentication/authorization) entry-point functions for Rust programs, the AC-finder counterpart to llm_api_functions.json. Used by find_ac_points to scan a RUPTA MIR dump for calls into known auth/authz crates so a reviewer can quickly enumerate every access-control decision point in a codebase.",
        "usage": "find_ac_points matches MIR call sites against fn_name using the same three-strategy regex approach as find_llm_calls (direct / angle-bracket / short-name — see llm_api_finder.rs for the exact matching rules, reused verbatim by ac_finder.rs).",
        "match_rule": "same textual match as llm_api_functions.json: direct path match, angle-bracket turbofish match, or last-two-segment short-name match against the MIR callee text",
        "category_values": "authentication | authorization | policy-enforcement | raw-http",
        "verification_caveat": "These signatures come from general knowledge of each crate's public API shape and have not been independently re-verified against current published docs (no context7/docs.rs lookup was performed when this file was authored). Spot-check against the target's actual installed crate version before trusting a match."
    },

